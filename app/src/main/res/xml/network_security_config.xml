<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Android network_security_config.xml is static at build time and cannot check
      per-source runtime permissions. Because users may add custom plain-HTTP hosts
      with explicit confirmation, OS-level cleartext is permitted here while app-level
      TorrentHttpClient enforces HTTPS-by-default and blocks unauthorized HTTP requests
      and HTTPS-to-HTTP downgrade redirects at runtime.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
